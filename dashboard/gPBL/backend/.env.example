# Firebase
FIREBASE_DATABASE_URL=https://gpbl-iot-llms-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_CREDENTIALS=serviceAccountKey.json
FIREBASE_SENSOR_PATH=sensor_data
FIREBASE_ADVICE_PATH=advice
FIREBASE_LED_PATH=led_state

# OpenRouter LLM (optional — mock advice if left as placeholder)
OPENROUTER_API_KEY=sk-or-v1-your-key
