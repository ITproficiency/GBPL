ANALYZE_COOLDOWN_SEC=60

# History pipeline
SENSOR_POLL_INTERVAL_SEC=10
INSIGHT_WINDOW_MINUTES=5
INSIGHT_MIN_READINGS=5
INSIGHT_COOLDOWN_SEC=60
